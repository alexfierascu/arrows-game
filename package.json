{
  "name": "arrows-escape",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply arrows-escape --local",
    "db:remote": "wrangler d1 migrations apply arrows-escape --remote",
    "deploy": "wrangler deploy",
    "deploy:with-migrations": "wrangler d1 migrations apply arrows-escape --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}