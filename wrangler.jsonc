{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arrows-game",
	"main": "./src/worker.js",
	"compatibility_date": "2025-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arrows-game",
			"database_id": "3da07fef-f298-4f0a-842b-18c910f7c93d",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}