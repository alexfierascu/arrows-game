{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arrows-escape",
  "main": "./src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arrows-escape",
      // Paste the database_id printed by: npx wrangler d1 create arrows-escape
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
