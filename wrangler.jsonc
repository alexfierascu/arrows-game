{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arrows-game",
	"main": "./src/worker.js",
	"compatibility_date": "2025-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arrows-game",
			"database_id": "3da07fef-f298-4f0a-842b-18c910f7c93d",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"VAPID_PUBLIC_KEY": "BJYWRAj-ZT176MxIpH2LIKbT9fzhwhrjzwIni688VoMD-V-8xxsMc2WtMY5GakuELkSdlYvnz3JqSw9YVi_LE_c",
		"VAPID_SUBJECT": "https://arrows-game.univocal.workers.dev"
	},
	"observability": {
		"enabled": true
	}
}